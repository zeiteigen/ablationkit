{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ablationkit:schema:worker-credentials.v1",
  "title": "WorkerCredentials",
  "description": "Scoped worker credentials: a launch token that can only perform the handshake (and so refresh), and a short-lived upload token.",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "launch_token",
    "launch_expires_at",
    "upload_token",
    "upload_expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "launch_token": {
      "maxLength": 200,
      "type": "string"
    },
    "launch_expires_at": {
      "title": "Timestamp",
      "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "upload_token": {
      "maxLength": 200,
      "type": "string"
    },
    "upload_expires_at": {
      "title": "Timestamp",
      "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "ntfy": {
      "title": "WorkerNtfy",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "pattern": "^https?://[^ ]+$",
          "maxLength": 2048,
          "type": "string"
        },
        "token": {
          "maxLength": 500,
          "type": "string"
        }
      }
    },
    "artifact_store": {
      "title": "WorkerArtifactStore",
      "description": "Presigned PUT URLs for an S3-compatible store: the worker uploads a large artifact there without the coordinator, then reports a receipt naming the slot; the coordinator pulls, verifies the SHA-256, stores it through MLflow and deletes the object (ADR 0023 decision 24).",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "min_bytes",
        "slots"
      ],
      "properties": {
        "min_bytes": {
          "minimum": 0,
          "description": "Artifacts at least this large go to the store.",
          "type": "integer"
        },
        "slots": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "title": "WorkerStoreSlot",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "slot",
              "url",
              "expires_at"
            ],
            "properties": {
              "slot": {
                "minimum": 0,
                "maximum": 63,
                "type": "integer"
              },
              "url": {
                "pattern": "^https?://[^ ]+$",
                "maxLength": 4096,
                "type": "string"
              },
              "expires_at": {
                "title": "Timestamp",
                "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
