{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ablationkit:schema:research-record.v1",
  "title": "ResearchRecord",
  "description": "A coordinator-owned research record: hypothesis, approach, note, report, decision, conversation link or study.",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "project_id",
    "kind",
    "title",
    "tags",
    "links",
    "created_at",
    "updated_at",
    "created_by",
    "updated_by",
    "revision"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "record_id": {
      "title": "ResearchRecordId",
      "description": "Research record identifier, unique within a project. Generated as `<prefix>-<date>-<random>`; a study's ID is its `ablationkit.study_id` run tag.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "project_id": {
      "title": "ProjectId",
      "description": "Stable project identifier (lowercase slug). Never a path; paths live in the local registry.",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "type": "string"
    },
    "kind": {
      "title": "ResearchKind",
      "description": "What a research record is.",
      "anyOf": [
        {
          "const": "hypothesis",
          "type": "string"
        },
        {
          "const": "approach",
          "type": "string"
        },
        {
          "const": "note",
          "type": "string"
        },
        {
          "const": "report",
          "type": "string"
        },
        {
          "const": "decision",
          "type": "string"
        },
        {
          "const": "conversation",
          "type": "string"
        },
        {
          "const": "study",
          "type": "string"
        }
      ]
    },
    "title": {
      "minLength": 1,
      "maxLength": 300,
      "type": "string"
    },
    "status": {
      "pattern": "^[a-z][a-z_]{0,31}$",
      "description": "Kind-specific status, for example `testing` for a hypothesis.",
      "type": "string"
    },
    "summary": {
      "maxLength": 20000,
      "description": "The short description every kind carries except a conversation link: what it is, why it exists, what came out and what that means for the research goal, in a few sentences. Markdown with LaTeX (`$…$`).",
      "type": "string"
    },
    "body": {
      "maxLength": 1000000,
      "description": "The in-depth read, Markdown with LaTeX (`$…$`, `$$…$$`) and tables: a note's text, a report's interpretation, a decision's rationale, an approach's or hypothesis's details, a study's design and reading; a conversation's personal notes.",
      "type": "string"
    },
    "tags": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,63}$",
        "type": "string"
      }
    },
    "links": {
      "maxItems": 500,
      "description": "Related projects' objects: hypotheses, runs, reports, studies and so on.",
      "type": "array",
      "items": {
        "title": "ObjectRef",
        "description": "A pointer to a research record, run, job, artifact or other object.",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "id"
        ],
        "properties": {
          "kind": {
            "title": "RefKind",
            "description": "Kind of object a reference points at. Compound IDs: variant `study/variant`, metric `run/key`, artifact `run/path`, prompt version `name/version`, golden set `gs-…/version` (or `gs-…` for the set).",
            "anyOf": [
              {
                "const": "hypothesis",
                "type": "string"
              },
              {
                "const": "approach",
                "type": "string"
              },
              {
                "const": "note",
                "type": "string"
              },
              {
                "const": "report",
                "type": "string"
              },
              {
                "const": "decision",
                "type": "string"
              },
              {
                "const": "conversation",
                "type": "string"
              },
              {
                "const": "study",
                "type": "string"
              },
              {
                "const": "variant",
                "type": "string"
              },
              {
                "const": "job",
                "type": "string"
              },
              {
                "const": "attempt",
                "type": "string"
              },
              {
                "const": "run",
                "type": "string"
              },
              {
                "const": "metric",
                "type": "string"
              },
              {
                "const": "artifact",
                "type": "string"
              },
              {
                "const": "commit",
                "type": "string"
              },
              {
                "const": "dataset",
                "type": "string"
              },
              {
                "const": "evaluation",
                "type": "string"
              },
              {
                "const": "logged_model",
                "type": "string"
              },
              {
                "const": "model_version",
                "type": "string"
              },
              {
                "const": "trace",
                "type": "string"
              },
              {
                "const": "task",
                "type": "string"
              },
              {
                "const": "inference_session",
                "type": "string"
              },
              {
                "const": "inference_evidence",
                "type": "string"
              },
              {
                "const": "prompt_version",
                "type": "string"
              },
              {
                "const": "golden_set",
                "type": "string"
              },
              {
                "const": "llm_evaluation",
                "type": "string"
              },
              {
                "const": "llm_evidence",
                "type": "string"
              },
              {
                "const": "extension_execution",
                "type": "string"
              }
            ]
          },
          "id": {
            "minLength": 1,
            "maxLength": 1024,
            "type": "string"
          },
          "label": {
            "maxLength": 300,
            "type": "string"
          }
        }
      }
    },
    "created_at": {
      "title": "Timestamp",
      "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "updated_at": {
      "title": "Timestamp",
      "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "created_by": {
      "title": "ResearchActor",
      "description": "Who made a change: a human session, an agent token or the system. Work under a task links the task (`task:ID`).",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "anyOf": [
            {
              "const": "human",
              "type": "string"
            },
            {
              "const": "agent",
              "type": "string"
            },
            {
              "const": "system",
              "type": "string"
            }
          ]
        },
        "id": {
          "maxLength": 200,
          "type": "string"
        }
      }
    },
    "updated_by": {
      "title": "ResearchActor",
      "description": "Who made a change: a human session, an agent token or the system. Work under a task links the task (`task:ID`).",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "anyOf": [
            {
              "const": "human",
              "type": "string"
            },
            {
              "const": "agent",
              "type": "string"
            },
            {
              "const": "system",
              "type": "string"
            }
          ]
        },
        "id": {
          "maxLength": 200,
          "type": "string"
        }
      }
    },
    "revision": {
      "minimum": 1,
      "description": "Incremented on every change; updates may require the revision they read.",
      "type": "integer"
    },
    "archived_at": {
      "title": "Timestamp",
      "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "attribution": {
      "title": "NoteAttribution",
      "description": "A note that quotes or summarizes a linked conversation. The text is the researcher's; nothing is fetched.",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "conversation_id",
        "mode"
      ],
      "properties": {
        "conversation_id": {
          "title": "ResearchRecordId",
          "description": "Research record identifier, unique within a project. Generated as `<prefix>-<date>-<random>`; a study's ID is its `ablationkit.study_id` run tag.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "const": "quote",
              "type": "string"
            },
            {
              "const": "summary",
              "type": "string"
            }
          ]
        }
      }
    },
    "evidence": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "title": "EvidenceItem",
        "description": "One cited piece of evidence: what was observed, and exactly where, kept apart from interpretation.",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ref",
          "captured_at"
        ],
        "properties": {
          "ref": {
            "title": "ObjectRef",
            "description": "A pointer to a research record, run, job, artifact or other object.",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "title": "RefKind",
                "description": "Kind of object a reference points at. Compound IDs: variant `study/variant`, metric `run/key`, artifact `run/path`, prompt version `name/version`, golden set `gs-…/version` (or `gs-…` for the set).",
                "anyOf": [
                  {
                    "const": "hypothesis",
                    "type": "string"
                  },
                  {
                    "const": "approach",
                    "type": "string"
                  },
                  {
                    "const": "note",
                    "type": "string"
                  },
                  {
                    "const": "report",
                    "type": "string"
                  },
                  {
                    "const": "decision",
                    "type": "string"
                  },
                  {
                    "const": "conversation",
                    "type": "string"
                  },
                  {
                    "const": "study",
                    "type": "string"
                  },
                  {
                    "const": "variant",
                    "type": "string"
                  },
                  {
                    "const": "job",
                    "type": "string"
                  },
                  {
                    "const": "attempt",
                    "type": "string"
                  },
                  {
                    "const": "run",
                    "type": "string"
                  },
                  {
                    "const": "metric",
                    "type": "string"
                  },
                  {
                    "const": "artifact",
                    "type": "string"
                  },
                  {
                    "const": "commit",
                    "type": "string"
                  },
                  {
                    "const": "dataset",
                    "type": "string"
                  },
                  {
                    "const": "evaluation",
                    "type": "string"
                  },
                  {
                    "const": "logged_model",
                    "type": "string"
                  },
                  {
                    "const": "model_version",
                    "type": "string"
                  },
                  {
                    "const": "trace",
                    "type": "string"
                  },
                  {
                    "const": "task",
                    "type": "string"
                  },
                  {
                    "const": "inference_session",
                    "type": "string"
                  },
                  {
                    "const": "inference_evidence",
                    "type": "string"
                  },
                  {
                    "const": "prompt_version",
                    "type": "string"
                  },
                  {
                    "const": "golden_set",
                    "type": "string"
                  },
                  {
                    "const": "llm_evaluation",
                    "type": "string"
                  },
                  {
                    "const": "llm_evidence",
                    "type": "string"
                  },
                  {
                    "const": "extension_execution",
                    "type": "string"
                  }
                ]
              },
              "id": {
                "minLength": 1,
                "maxLength": 1024,
                "type": "string"
              },
              "label": {
                "maxLength": 300,
                "type": "string"
              }
            }
          },
          "role": {
            "anyOf": [
              {
                "const": "baseline",
                "type": "string"
              },
              {
                "const": "candidate",
                "type": "string"
              },
              {
                "const": "supporting",
                "type": "string"
              },
              {
                "const": "contradicting",
                "type": "string"
              },
              {
                "const": "context",
                "type": "string"
              }
            ]
          },
          "mlflow_run_id": {
            "maxLength": 128,
            "type": "string"
          },
          "attempt_id": {
            "title": "AttemptId",
            "description": "Identifier of one attempt of a job.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "job_id": {
            "title": "JobId",
            "description": "AblationKit job identifier.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "variant_id": {
            "title": "VariantId",
            "description": "Variant identifier (one configuration or code change under test).",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "source_commit": {
            "pattern": "^[a-f0-9]{7,64}$",
            "type": "string"
          },
          "source_dirty": {
            "type": "boolean"
          },
          "values": {
            "description": "Metric values as recorded (latest value per key), as exact decimal strings: protocol schemas carry no floats.",
            "type": "object",
            "patternProperties": {
              "^(.*)$": {
                "maxLength": 64,
                "type": "string"
              }
            }
          },
          "artifacts": {
            "maxItems": 200,
            "description": "Artifact paths in the run.",
            "type": "array",
            "items": {
              "maxLength": 1024,
              "type": "string"
            }
          },
          "note": {
            "maxLength": 4000,
            "type": "string"
          },
          "captured_at": {
            "title": "Timestamp",
            "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
            "type": "string"
          }
        }
      }
    },
    "follow_up": {
      "maxLength": 100000,
      "type": "string"
    },
    "generated": {
      "title": "ReportGeneration",
      "description": "Set when the evidence section was generated from a study's runs.",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "study_id",
        "metric_keys",
        "runs",
        "generated_at"
      ],
      "properties": {
        "study_id": {
          "maxLength": 128,
          "type": "string"
        },
        "baseline_variant": {
          "title": "VariantId",
          "description": "Variant identifier (one configuration or code change under test).",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "metric_keys": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "maxLength": 250,
            "type": "string"
          }
        },
        "runs": {
          "minimum": 0,
          "type": "integer"
        },
        "generated_at": {
          "title": "Timestamp",
          "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
          "type": "string"
        }
      }
    },
    "source": {
      "title": "ConversationSource",
      "description": "Where an external conversation lives.",
      "anyOf": [
        {
          "const": "chatgpt",
          "type": "string"
        },
        {
          "const": "claude",
          "type": "string"
        },
        {
          "const": "claude_code",
          "type": "string"
        },
        {
          "const": "codex",
          "type": "string"
        },
        {
          "const": "other",
          "type": "string"
        }
      ]
    },
    "url": {
      "pattern": "^https?://.{1,4000}$",
      "type": "string"
    },
    "local_ref": {
      "maxLength": 4000,
      "description": "A local session reference, e.g. a Claude Code session ID. Not resolved.",
      "type": "string"
    },
    "conversation_created_at": {
      "title": "Timestamp",
      "description": "When the external conversation was created, if the researcher knows.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "export_notes": {
      "description": "Copy the personal notes into the Git-tracked export. Off by default (spec §9).",
      "type": "boolean"
    },
    "protocol": {
      "maxLength": 20000,
      "description": "Evaluation protocol of a study.",
      "type": "string"
    },
    "baseline_variant": {
      "title": "VariantId",
      "description": "Variant identifier (one configuration or code change under test).",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "variants": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "title": "StudyVariant",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "variant_id"
        ],
        "properties": {
          "variant_id": {
            "title": "VariantId",
            "description": "Variant identifier (one configuration or code change under test).",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": {
            "maxLength": 300,
            "type": "string"
          },
          "description": {
            "maxLength": 8000,
            "type": "string"
          }
        }
      }
    },
    "metric_goals": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "title": "MetricGoal",
        "description": "Which direction is better for a metric.",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "goal"
        ],
        "properties": {
          "key": {
            "minLength": 1,
            "maxLength": 250,
            "type": "string"
          },
          "goal": {
            "anyOf": [
              {
                "const": "min",
                "type": "string"
              },
              {
                "const": "max",
                "type": "string"
              }
            ]
          }
        }
      }
    }
  }
}
