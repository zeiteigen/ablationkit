{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ablationkit:schema:golden-set-record.v1",
  "title": "GoldenSetRecord",
  "description": "A fixed, versioned evaluation set. Versions are immutable files pinned by SHA-256; changing a set means adding a version.",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "golden_set_id",
    "project_id",
    "name",
    "held_out",
    "versions",
    "created_at",
    "updated_at",
    "created_by"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "golden_set_id": {
      "title": "GoldenSetId",
      "description": "Golden set ID, `gs-<id>`.",
      "pattern": "^gs-[a-z0-9]{6,40}$",
      "type": "string"
    },
    "project_id": {
      "title": "ProjectId",
      "description": "Stable project identifier (lowercase slug). Never a path; paths live in the local registry.",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$",
      "type": "string"
    },
    "description": {
      "maxLength": 4000,
      "type": "string"
    },
    "held_out": {
      "description": "A held-out set: only a researcher may add versions, and its expectations are never exported to the checkout.",
      "type": "boolean"
    },
    "versions": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "title": "GoldenSetVersion",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "sha256",
          "examples",
          "categories",
          "edge_cases",
          "missing_expectations",
          "created_at",
          "created_by"
        ],
        "properties": {
          "version": {
            "minimum": 1,
            "type": "integer"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 of the version's JSONL file; checked on every read.",
            "type": "string"
          },
          "examples": {
            "minimum": 0,
            "type": "integer"
          },
          "categories": {
            "type": "object",
            "patternProperties": {
              "^(.*)$": {
                "minimum": 0,
                "type": "integer"
              }
            }
          },
          "edge_cases": {
            "minimum": 0,
            "type": "integer"
          },
          "missing_expectations": {
            "minimum": 0,
            "type": "integer"
          },
          "parent_version": {
            "minimum": 1,
            "type": "integer"
          },
          "note": {
            "maxLength": 2000,
            "type": "string"
          },
          "created_at": {
            "title": "Timestamp",
            "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
            "type": "string"
          },
          "created_by": {
            "title": "LlmActor",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "anyOf": [
                  {
                    "const": "human",
                    "type": "string"
                  },
                  {
                    "const": "agent",
                    "type": "string"
                  },
                  {
                    "const": "system",
                    "type": "string"
                  }
                ]
              },
              "id": {
                "maxLength": 200,
                "type": "string"
              }
            }
          },
          "mlflow_dataset_id": {
            "maxLength": 100,
            "description": "The MLflow GenAI evaluation dataset mirroring this version.",
            "type": "string"
          }
        }
      }
    },
    "created_at": {
      "title": "Timestamp",
      "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "updated_at": {
      "title": "Timestamp",
      "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "created_by": {
      "title": "LlmActor",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "anyOf": [
            {
              "const": "human",
              "type": "string"
            },
            {
              "const": "agent",
              "type": "string"
            },
            {
              "const": "system",
              "type": "string"
            }
          ]
        },
        "id": {
          "maxLength": 200,
          "type": "string"
        }
      }
    }
  }
}
