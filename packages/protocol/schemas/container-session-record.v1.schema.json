{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ablationkit:schema:container-session-record.v1",
  "title": "ContainerSessionRecord",
  "description": "One agent container session (ADR 0061): the harness in its container, the agent session token minted for it, what the container was given, and the provenance recorded at its start and end.",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "project_id",
    "token_id",
    "harness",
    "label",
    "args",
    "checkout",
    "container",
    "image",
    "config_revision",
    "state",
    "started_by",
    "created_at",
    "supervisor",
    "boundary",
    "control"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "session_id": {
      "title": "ContainerSessionId",
      "description": "An agent container session: `c-` and twelve hex digits.",
      "pattern": "^c-[a-f0-9]{12}$",
      "type": "string"
    },
    "project_id": {
      "title": "ProjectId",
      "description": "Stable project identifier (lowercase slug). Never a path; paths live in the local registry.",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "type": "string"
    },
    "token_id": {
      "pattern": "^[a-f0-9]{16}$",
      "description": "The agent session token minted for it.",
      "type": "string"
    },
    "harness": {
      "title": "ContainerHarness",
      "description": "What runs in the agent container: Claude Code, Codex, or a plain shell (to set the container up or look around).",
      "anyOf": [
        {
          "const": "claude-code",
          "type": "string"
        },
        {
          "const": "codex",
          "type": "string"
        },
        {
          "const": "shell",
          "type": "string"
        }
      ]
    },
    "label": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "args": {
      "maxItems": 64,
      "description": "Extra arguments given to the harness.",
      "type": "array",
      "items": {
        "maxLength": 4096,
        "type": "string"
      }
    },
    "checkout": {
      "pattern": "^/.*$",
      "maxLength": 4096,
      "type": "string"
    },
    "container": {
      "pattern": "^ak-agent-c-[a-f0-9]{12}$",
      "type": "string"
    },
    "image": {
      "maxLength": 512,
      "type": "string"
    },
    "image_id": {
      "maxLength": 200,
      "type": "string"
    },
    "harness_version": {
      "maxLength": 200,
      "type": "string"
    },
    "config_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "state": {
      "title": "ContainerSessionState",
      "description": "`exited`: the harness ended (its exit code is recorded). `failed`: the container did not start. `lost`: the container was gone without an exit being recorded.",
      "anyOf": [
        {
          "const": "starting",
          "type": "string"
        },
        {
          "const": "running",
          "type": "string"
        },
        {
          "const": "paused",
          "type": "string"
        },
        {
          "const": "exited",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "lost",
          "type": "string"
        }
      ]
    },
    "paused_by": {
      "anyOf": [
        {
          "const": "researcher",
          "type": "string"
        },
        {
          "const": "compute_limit",
          "type": "string"
        }
      ]
    },
    "started_by": {
      "maxLength": 200,
      "type": "string"
    },
    "created_at": {
      "title": "Timestamp",
      "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "started_at": {
      "title": "Timestamp",
      "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "ended_at": {
      "title": "Timestamp",
      "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "exit_code": {
      "type": "integer"
    },
    "error": {
      "maxLength": 2000,
      "type": "string"
    },
    "supervisor": {
      "title": "ContainerSupervisor",
      "description": "Where the terminal the container is attached to lives: a tmux server in a transient systemd unit, or a detached process.",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "anyOf": [
            {
              "const": "systemd",
              "type": "string"
            },
            {
              "const": "direct",
              "type": "string"
            }
          ]
        },
        "unit": {
          "maxLength": 256,
          "type": "string"
        }
      }
    },
    "boundary": {
      "title": "ContainerBoundary",
      "description": "What the container was given when it started, as applied.",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "gpu",
        "network",
        "egress",
        "hidden",
        "read_only",
        "cpus",
        "memory_mb",
        "pids_max"
      ],
      "properties": {
        "gpu": {
          "const": false,
          "type": "boolean"
        },
        "network": {
          "const": "none",
          "type": "string"
        },
        "egress": {
          "anyOf": [
            {
              "const": "allowlist",
              "type": "string"
            },
            {
              "const": "open",
              "type": "string"
            }
          ]
        },
        "hidden": {
          "maxItems": 128,
          "type": "array",
          "items": {
            "maxLength": 4096,
            "type": "string"
          }
        },
        "read_only": {
          "maxItems": 128,
          "type": "array",
          "items": {
            "maxLength": 4096,
            "type": "string"
          }
        },
        "cpus": {
          "minimum": 1,
          "type": "integer"
        },
        "memory_mb": {
          "minimum": 1,
          "type": "integer"
        },
        "pids_max": {
          "minimum": 1,
          "type": "integer"
        }
      }
    },
    "start": {
      "title": "ContainerSnapshot",
      "description": "The checkout's commit and uncommitted files, and the project environment's packages, at a point of the session.",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "at",
        "dirty",
        "packages"
      ],
      "properties": {
        "at": {
          "title": "Timestamp",
          "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
          "type": "string"
        },
        "head": {
          "pattern": "^[a-f0-9]{7,64}$",
          "type": "string"
        },
        "dirty": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "maxLength": 4096,
            "type": "string"
          }
        },
        "packages": {
          "maxItems": 5000,
          "type": "array",
          "items": {
            "title": "ContainerPackage",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "maxLength": 200,
                "type": "string"
              },
              "version": {
                "maxLength": 100,
                "type": "string"
              },
              "previous": {
                "maxLength": 100,
                "description": "Changed: the old version.",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "end": {
      "title": "ContainerSnapshot",
      "description": "The checkout's commit and uncommitted files, and the project environment's packages, at a point of the session.",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "at",
        "dirty",
        "packages"
      ],
      "properties": {
        "at": {
          "title": "Timestamp",
          "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
          "type": "string"
        },
        "head": {
          "pattern": "^[a-f0-9]{7,64}$",
          "type": "string"
        },
        "dirty": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "maxLength": 4096,
            "type": "string"
          }
        },
        "packages": {
          "maxItems": 5000,
          "type": "array",
          "items": {
            "title": "ContainerPackage",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "maxLength": 200,
                "type": "string"
              },
              "version": {
                "maxLength": 100,
                "type": "string"
              },
              "previous": {
                "maxLength": 100,
                "description": "Changed: the old version.",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "files_changed": {
      "maxItems": 2000,
      "description": "Between the start and end snapshots, from Git: the bind-mounted checkout also shows the researcher's own edits made meanwhile.",
      "type": "array",
      "items": {
        "title": "ContainerFileChange",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "status"
        ],
        "properties": {
          "path": {
            "maxLength": 4096,
            "type": "string"
          },
          "status": {
            "maxLength": 8,
            "description": "Git's status letters (A, M, D, R, ??).",
            "type": "string"
          }
        }
      }
    },
    "packages_changed": {
      "title": "ContainerPackagesChanged",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "added",
        "removed",
        "changed"
      ],
      "properties": {
        "added": {
          "maxItems": 2000,
          "type": "array",
          "items": {
            "title": "ContainerPackage",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "maxLength": 200,
                "type": "string"
              },
              "version": {
                "maxLength": 100,
                "type": "string"
              },
              "previous": {
                "maxLength": 100,
                "description": "Changed: the old version.",
                "type": "string"
              }
            }
          }
        },
        "removed": {
          "maxItems": 2000,
          "type": "array",
          "items": {
            "title": "ContainerPackage",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "maxLength": 200,
                "type": "string"
              },
              "version": {
                "maxLength": 100,
                "type": "string"
              },
              "previous": {
                "maxLength": 100,
                "description": "Changed: the old version.",
                "type": "string"
              }
            }
          }
        },
        "changed": {
          "maxItems": 2000,
          "type": "array",
          "items": {
            "title": "ContainerPackage",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "maxLength": 200,
                "type": "string"
              },
              "version": {
                "maxLength": 100,
                "type": "string"
              },
              "previous": {
                "maxLength": 100,
                "description": "Changed: the old version.",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "commands": {
      "maxItems": 1000,
      "description": "Shell commands as the harness's own transcript recorded them (the agent can write its home, so this is its account, not the coordinator's record).",
      "type": "array",
      "items": {
        "title": "ContainerCommand",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "command"
        ],
        "properties": {
          "at": {
            "title": "Timestamp",
            "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
            "type": "string"
          },
          "command": {
            "maxLength": 2000,
            "type": "string"
          }
        }
      }
    },
    "login": {
      "title": "ContainerLogin",
      "description": "The researcher's Claude Code login, copied into the container at start; while the session runs a renewal made on this machine is carried in, and one made in the container is never carried back (ADR 0063). The container's copy is deleted when the session ends.",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "source",
        "copied_at",
        "synced_back",
        "synced_in"
      ],
      "properties": {
        "source": {
          "maxLength": 4096,
          "description": "The Claude Code configuration directory the login was copied from.",
          "type": "string"
        },
        "copied_at": {
          "title": "Timestamp",
          "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
          "type": "string"
        },
        "synced_back": {
          "minimum": 0,
          "description": "Renewals made in the container and carried back to the source: none since ADR 0063 was amended (a renewal made inside stays there); earlier sessions' counts.",
          "type": "integer"
        },
        "synced_in": {
          "minimum": 0,
          "description": "Renewals made on this machine and carried into the container.",
          "type": "integer"
        },
        "stopped": {
          "maxLength": 500,
          "description": "Sessions from before ADR 0063 was amended: why carrying renewals back stopped (another account signed in).",
          "type": "string"
        }
      }
    },
    "control": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "title": "ContainerControl",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "at",
          "action",
          "by"
        ],
        "properties": {
          "at": {
            "title": "Timestamp",
            "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
            "type": "string"
          },
          "action": {
            "anyOf": [
              {
                "const": "pause",
                "type": "string"
              },
              {
                "const": "resume",
                "type": "string"
              },
              {
                "const": "stop",
                "type": "string"
              }
            ]
          },
          "by": {
            "maxLength": 200,
            "type": "string"
          },
          "reason": {
            "maxLength": 500,
            "type": "string"
          }
        }
      }
    }
  }
}
