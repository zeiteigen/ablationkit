{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ablationkit:schema:worker-handshake-reply.v1",
  "title": "WorkerHandshakeReply",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "spool_acked_seq",
    "cancel_requested",
    "heartbeat_sec",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "spool_acked_seq": {
      "minimum": -1,
      "type": "integer"
    },
    "cancel_requested": {
      "type": "boolean"
    },
    "heartbeat_sec": {
      "minimum": 1,
      "type": "integer"
    },
    "upload_token": {
      "maxLength": 200,
      "type": "string"
    },
    "upload_expires_at": {
      "title": "Timestamp",
      "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "artifacts": {
      "maxItems": 10000,
      "description": "Artifacts already received, so they are not re-sent.",
      "type": "array",
      "items": {
        "title": "ReceivedArtifact",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "maxLength": 1024,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        }
      }
    }
  }
}
