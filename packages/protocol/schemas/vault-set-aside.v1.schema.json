{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ablationkit:schema:vault-set-aside.v1",
  "title": "VaultSetAside",
  "description": "The runs the agent set aside, each with its reason (ADR 0056): a run a task's jobs produced is cited by a note or set aside, or it is unaccounted for. The reason is the agent's account, not the coordinator's record; a mark gates nothing.",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "project_id": {
      "title": "ProjectId",
      "description": "Stable project identifier (lowercase slug). Never a path; paths live in the local registry.",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "type": "string"
    },
    "runs": {
      "description": "Set-aside marks by MLflow run ID.",
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "title": "VaultSetAsideMark",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "reason",
            "at",
            "by"
          ],
          "properties": {
            "reason": {
              "minLength": 1,
              "maxLength": 1000,
              "description": "Why the run is not reported: diverged, superseded by a rerun, a bug in the code it ran, an exploratory probe. As the agent wrote it.",
              "type": "string"
            },
            "run_name": {
              "minLength": 1,
              "maxLength": 250,
              "type": "string"
            },
            "at": {
              "title": "Timestamp",
              "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            "by": {
              "title": "ResearchActor",
              "description": "Who made a change: a human session, an agent token or the system. Work under a task links the task (`task:ID`).",
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "anyOf": [
                    {
                      "const": "human",
                      "type": "string"
                    },
                    {
                      "const": "agent",
                      "type": "string"
                    },
                    {
                      "const": "system",
                      "type": "string"
                    }
                  ]
                },
                "id": {
                  "maxLength": 200,
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
