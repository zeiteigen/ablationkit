{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ablationkit:schema:pending-restore.v1",
  "title": "PendingRestore",
  "description": "A restore of one of this home's backups, applied at the next coordinator start.",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "backup_id",
    "requested_at",
    "requested_by"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "backup_id": {
      "pattern": "^[0-9]{8}T[0-9]{6}Z(-[a-z0-9-]{1,40})?$",
      "type": "string"
    },
    "requested_at": {
      "title": "Timestamp",
      "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "requested_by": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    }
  }
}
