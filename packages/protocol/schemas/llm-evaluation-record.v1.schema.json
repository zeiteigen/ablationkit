{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ablationkit:schema:llm-evaluation-record.v1",
  "title": "LlmEvaluationRecord",
  "description": "A GenAI evaluation (`mlflow.genai.evaluate`) of one to six pinned targets over one golden-set version. Each target is its own MLflow run with traces and assessments; per-example results are the run's `ablationkit/llm/examples.json` artifact.",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "evaluation_id",
    "project_id",
    "kind",
    "golden_set",
    "targets",
    "scorers",
    "trials",
    "retention",
    "egress",
    "environment",
    "state",
    "results",
    "limits",
    "requested_by",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "evaluation_id": {
      "title": "LlmEvaluationId",
      "description": "GenAI evaluation ID, `le-<id>`.",
      "pattern": "^le-[a-z0-9]{6,40}$",
      "type": "string"
    },
    "project_id": {
      "title": "ProjectId",
      "description": "Stable project identifier (lowercase slug). Never a path; paths live in the local registry.",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "type": "string"
    },
    "kind": {
      "const": "genai",
      "type": "string"
    },
    "golden_set": {
      "title": "PinnedGoldenSet",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "golden_set_id",
        "name",
        "version",
        "sha256",
        "held_out",
        "examples"
      ],
      "properties": {
        "golden_set_id": {
          "title": "GoldenSetId",
          "description": "Golden set ID, `gs-<id>`.",
          "pattern": "^gs-[a-z0-9]{6,40}$",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "held_out": {
          "type": "boolean"
        },
        "examples": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "targets": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "title": "PromptTarget",
            "description": "A pinned prompt version rendered with each example's inputs and sent to one provider model.",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "kind",
              "label",
              "prompt",
              "provider_id",
              "model",
              "params"
            ],
            "properties": {
              "kind": {
                "const": "prompt",
                "type": "string"
              },
              "label": {
                "pattern": "^[A-Za-z0-9_.-]{1,40}$",
                "type": "string"
              },
              "prompt": {
                "title": "PinnedPrompt",
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "name",
                  "version",
                  "template_sha256",
                  "format"
                ],
                "properties": {
                  "name": {
                    "minLength": 1,
                    "maxLength": 256,
                    "type": "string"
                  },
                  "version": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "alias": {
                    "maxLength": 256,
                    "description": "The alias the request named; `version` is what it resolved to.",
                    "type": "string"
                  },
                  "template_sha256": {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  },
                  "format": {
                    "anyOf": [
                      {
                        "const": "text",
                        "type": "string"
                      },
                      {
                        "const": "chat",
                        "type": "string"
                      }
                    ]
                  }
                }
              },
              "provider_id": {
                "title": "LlmProviderId",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
                "type": "string"
              },
              "model": {
                "minLength": 1,
                "maxLength": 200,
                "type": "string"
              },
              "params": {
                "title": "GenerationParams",
                "additionalProperties": false,
                "type": "object",
                "properties": {
                  "temperature": {
                    "pattern": "^-?[0-9]+([.][0-9]+)?([eE][-+]?[0-9]+)?$",
                    "maxLength": 40,
                    "description": "0..2",
                    "type": "string"
                  },
                  "top_p": {
                    "pattern": "^-?[0-9]+([.][0-9]+)?([eE][-+]?[0-9]+)?$",
                    "maxLength": 40,
                    "description": "0..1",
                    "type": "string"
                  },
                  "max_tokens": {
                    "minimum": 1,
                    "maximum": 32768,
                    "type": "integer"
                  },
                  "seed": {
                    "minimum": 0,
                    "maximum": 2147483647,
                    "description": "Sent to the provider; honoured only if the provider supports it, so repeated trials are not exact reproductions.",
                    "type": "integer"
                  },
                  "stop": {
                    "maxItems": 4,
                    "type": "array",
                    "items": {
                      "maxLength": 100,
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          {
            "title": "RecordedTarget",
            "description": "Traces a project's own application recorded (for example a RAG job over the golden set); they are scored, not regenerated.",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "kind",
              "label",
              "source_run_id",
              "traces",
              "matched"
            ],
            "properties": {
              "kind": {
                "const": "recorded",
                "type": "string"
              },
              "label": {
                "pattern": "^[A-Za-z0-9_.-]{1,40}$",
                "type": "string"
              },
              "source_run_id": {
                "title": "MlflowRunId",
                "description": "MLflow run ID, as MLflow returns it.",
                "pattern": "^[A-Za-z0-9_-]{1,64}$",
                "type": "string"
              },
              "traces": {
                "minimum": 0,
                "type": "integer"
              },
              "matched": {
                "minimum": 0,
                "description": "Traces tagged with an example ID of the golden-set version.",
                "type": "integer"
              }
            }
          }
        ]
      }
    },
    "scorers": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "title": "ScorerRef",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "pattern": "^[a-z0-9_]{1,64}$",
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "const": "builtin",
                "type": "string"
              },
              {
                "const": "judge",
                "type": "string"
              },
              {
                "const": "project",
                "type": "string"
              }
            ]
          },
          "builtin": {
            "anyOf": [
              {
                "const": "exact_match",
                "type": "string"
              },
              {
                "const": "contains_expected",
                "type": "string"
              },
              {
                "const": "expected_facts",
                "type": "string"
              },
              {
                "const": "regex",
                "type": "string"
              },
              {
                "const": "max_length",
                "type": "string"
              },
              {
                "const": "retrieval_recall",
                "type": "string"
              },
              {
                "const": "has_citation",
                "type": "string"
              },
              {
                "const": "tool_called",
                "type": "string"
              }
            ]
          },
          "params": {
            "type": "object",
            "patternProperties": {
              "^(.*)$": {
                "maxLength": 500,
                "type": "string"
              }
            }
          },
          "judge": {
            "title": "JudgeProvenance",
            "description": "The judge model, rubric and settings, kept with every judged result. Judge output is an opinion, not ground truth.",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "provider_id",
              "model",
              "locality",
              "rubric",
              "rubric_sha256",
              "uses",
              "params"
            ],
            "properties": {
              "provider_id": {
                "title": "LlmProviderId",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
                "type": "string"
              },
              "model": {
                "minLength": 1,
                "maxLength": 200,
                "type": "string"
              },
              "locality": {
                "anyOf": [
                  {
                    "const": "local",
                    "type": "string"
                  },
                  {
                    "const": "external",
                    "type": "string"
                  }
                ]
              },
              "rubric": {
                "minLength": 1,
                "maxLength": 8000,
                "type": "string"
              },
              "rubric_sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "uses": {
                "description": "`grounding` judges the answer against the trace's retrieved passages.",
                "anyOf": [
                  {
                    "const": "answer",
                    "type": "string"
                  },
                  {
                    "const": "grounding",
                    "type": "string"
                  }
                ]
              },
              "params": {
                "title": "GenerationParams",
                "additionalProperties": false,
                "type": "object",
                "properties": {
                  "temperature": {
                    "pattern": "^-?[0-9]+([.][0-9]+)?([eE][-+]?[0-9]+)?$",
                    "maxLength": 40,
                    "description": "0..2",
                    "type": "string"
                  },
                  "top_p": {
                    "pattern": "^-?[0-9]+([.][0-9]+)?([eE][-+]?[0-9]+)?$",
                    "maxLength": 40,
                    "description": "0..1",
                    "type": "string"
                  },
                  "max_tokens": {
                    "minimum": 1,
                    "maximum": 32768,
                    "type": "integer"
                  },
                  "seed": {
                    "minimum": 0,
                    "maximum": 2147483647,
                    "description": "Sent to the provider; honoured only if the provider supports it, so repeated trials are not exact reproductions.",
                    "type": "integer"
                  },
                  "stop": {
                    "maxItems": 4,
                    "type": "array",
                    "items": {
                      "maxLength": 100,
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "project": {
            "title": "ProjectScorer",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "path",
              "function",
              "sha256"
            ],
            "properties": {
              "path": {
                "maxLength": 500,
                "type": "string"
              },
              "function": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,99}$",
                "type": "string"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "commit": {
                "maxLength": 64,
                "type": "string"
              }
            }
          }
        }
      }
    },
    "trials": {
      "minimum": 1,
      "maximum": 10,
      "description": "Repeated generations per example; outputs are distributions, not exact reproductions.",
      "type": "integer"
    },
    "retention": {
      "title": "DeclaredRetention",
      "description": "The data-retention policy this evaluation's traces were recorded under.",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "capture",
        "retention_days",
        "settings_revision"
      ],
      "properties": {
        "capture": {
          "title": "CaptureMode",
          "description": "What trace bodies (prompts, outputs, retrieved passages, tool arguments) are kept. `full`: as recorded. `redacted`: with the redaction rules applied. `metadata_only`: span names, types, timings, status and token counts, no bodies. `off`: playground and job traces are not written at all (evaluations still record metadata-only traces, which MLflow needs).",
          "anyOf": [
            {
              "const": "full",
              "type": "string"
            },
            {
              "const": "redacted",
              "type": "string"
            },
            {
              "const": "metadata_only",
              "type": "string"
            },
            {
              "const": "off",
              "type": "string"
            }
          ]
        },
        "retention_days": {
          "minimum": 1,
          "type": "integer"
        },
        "settings_revision": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "egress": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "title": "LlmEgressUse",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "provider_id",
          "locality",
          "purpose"
        ],
        "properties": {
          "provider_id": {
            "title": "LlmProviderId",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
            "type": "string"
          },
          "locality": {
            "anyOf": [
              {
                "const": "local",
                "type": "string"
              },
              {
                "const": "external",
                "type": "string"
              }
            ]
          },
          "purpose": {
            "anyOf": [
              {
                "const": "generation",
                "type": "string"
              },
              {
                "const": "judge",
                "type": "string"
              }
            ]
          },
          "approved_at": {
            "title": "Timestamp",
            "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
            "type": "string"
          }
        }
      }
    },
    "environment": {
      "description": "`managed`: the operations bridge on the workstation (`mlflow.genai.evaluate`). `remote`: a job on a compute target (`remote`).",
      "anyOf": [
        {
          "const": "managed",
          "type": "string"
        },
        {
          "const": "remote",
          "type": "string"
        }
      ]
    },
    "remote": {
      "title": "LlmEvaluationRemote",
      "description": "A remote GenAI evaluation (ADR 0023 decision 25): a job whose bundle carries the request (examples, prompts, keyless provider endpoints, scorers). It survives a coordinator restart and reconciles once; the targets' runs are filled from its `eval/genai-results.json`.",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "target_id",
        "job_id",
        "request_sha256"
      ],
      "properties": {
        "target_id": {
          "pattern": "^[a-z][a-z0-9-]{0,39}$",
          "type": "string"
        },
        "job_id": {
          "title": "JobId",
          "description": "AblationKit job identifier.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "attempt_id": {
          "title": "AttemptId",
          "description": "Identifier of one attempt of a job.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "note": {
          "maxLength": 1000,
          "description": "Why the evaluation is still open (waiting for the worker's results, or an `unknown` attempt a human must resolve; it is never rerun).",
          "type": "string"
        }
      }
    },
    "state": {
      "title": "LlmEvaluationState",
      "anyOf": [
        {
          "const": "queued",
          "type": "string"
        },
        {
          "const": "running",
          "type": "string"
        },
        {
          "const": "succeeded",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "canceled",
          "type": "string"
        },
        {
          "const": "interrupted",
          "type": "string"
        }
      ]
    },
    "experiment_id": {
      "title": "MlflowExperimentId",
      "description": "MLflow experiment ID, as MLflow returns it.",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "type": "string"
    },
    "results": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "title": "LlmVariantResult",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "pattern": "^[A-Za-z0-9_.-]{1,40}$",
            "type": "string"
          },
          "run_id": {
            "title": "MlflowRunId",
            "description": "MLflow run ID, as MLflow returns it.",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "metrics": {
            "type": "object",
            "patternProperties": {
              "^(.*)$": {
                "pattern": "^-?[0-9]+([.][0-9]+)?([eE][-+]?[0-9]+)?$",
                "maxLength": 40,
                "description": "A scorer aggregate.",
                "type": "string"
              }
            }
          },
          "examples": {
            "minimum": 0,
            "type": "integer"
          },
          "errors": {
            "minimum": 0,
            "description": "Examples whose generation failed.",
            "type": "integer"
          },
          "scorer_errors": {
            "minimum": 0,
            "type": "integer"
          },
          "usage": {
            "title": "UsageSummary",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "reported",
              "missing"
            ],
            "properties": {
              "input_tokens": {
                "minimum": 0,
                "type": "integer"
              },
              "output_tokens": {
                "minimum": 0,
                "type": "integer"
              },
              "total_tokens": {
                "minimum": 0,
                "type": "integer"
              },
              "reported": {
                "minimum": 0,
                "description": "Calls whose provider reported usage.",
                "type": "integer"
              },
              "missing": {
                "minimum": 0,
                "description": "Calls with no reported usage (never estimated).",
                "type": "integer"
              }
            }
          },
          "judge_usage": {
            "title": "UsageSummary",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "reported",
              "missing"
            ],
            "properties": {
              "input_tokens": {
                "minimum": 0,
                "type": "integer"
              },
              "output_tokens": {
                "minimum": 0,
                "type": "integer"
              },
              "total_tokens": {
                "minimum": 0,
                "type": "integer"
              },
              "reported": {
                "minimum": 0,
                "description": "Calls whose provider reported usage.",
                "type": "integer"
              },
              "missing": {
                "minimum": 0,
                "description": "Calls with no reported usage (never estimated).",
                "type": "integer"
              }
            }
          },
          "latency_ms": {
            "title": "LatencySummary",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "mean",
              "p50",
              "max"
            ],
            "properties": {
              "mean": {
                "minimum": 0,
                "description": "Whole milliseconds.",
                "type": "integer"
              },
              "p50": {
                "minimum": 0,
                "description": "Whole milliseconds.",
                "type": "integer"
              },
              "max": {
                "minimum": 0,
                "description": "Whole milliseconds.",
                "type": "integer"
              }
            }
          },
          "cost": {
            "title": "CostEstimate",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "estimated_usd",
              "basis",
              "rate_source",
              "rate_version",
              "partial"
            ],
            "properties": {
              "estimated_usd": {
                "pattern": "^-?[0-9]+([.][0-9]+)?([eE][-+]?[0-9]+)?$",
                "maxLength": 40,
                "description": "An estimate from reported tokens times the rate; not a billed amount.",
                "type": "string"
              },
              "basis": {
                "maxLength": 500,
                "type": "string"
              },
              "rate_source": {
                "maxLength": 300,
                "type": "string"
              },
              "rate_version": {
                "maxLength": 100,
                "type": "string"
              },
              "partial": {
                "description": "Some calls had no reported usage, so the estimate leaves them out.",
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "source_commit": {
      "maxLength": 64,
      "type": "string"
    },
    "limits": {
      "title": "LlmEvaluationLimits",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "timeout_sec",
        "max_calls"
      ],
      "properties": {
        "timeout_sec": {
          "minimum": 10,
          "maximum": 86400,
          "type": "integer"
        },
        "max_calls": {
          "minimum": 1,
          "maximum": 100000,
          "type": "integer"
        }
      }
    },
    "enforcement": {
      "anyOf": [
        {
          "const": "enforced",
          "type": "string"
        },
        {
          "const": "advisory",
          "type": "string"
        }
      ]
    },
    "error": {
      "maxLength": 4000,
      "type": "string"
    },
    "requested_by": {
      "title": "LlmActor",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "anyOf": [
            {
              "const": "human",
              "type": "string"
            },
            {
              "const": "agent",
              "type": "string"
            },
            {
              "const": "system",
              "type": "string"
            }
          ]
        },
        "id": {
          "maxLength": 200,
          "type": "string"
        }
      }
    },
    "created_at": {
      "title": "Timestamp",
      "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "updated_at": {
      "title": "Timestamp",
      "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "started_at": {
      "title": "Timestamp",
      "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "ended_at": {
      "title": "Timestamp",
      "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    }
  }
}
