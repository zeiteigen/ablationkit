{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ablationkit:schema:resumable-upload.v1",
  "title": "ResumableUpload",
  "description": "Chunked upload state: an interrupted upload resumes at `received` (spec §5.7: interrupted artifact upload).",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "upload_id",
    "attempt_id",
    "path",
    "size",
    "sha256",
    "received",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "upload_id": {
      "pattern": "^u-[a-f0-9]{16}$",
      "type": "string"
    },
    "attempt_id": {
      "title": "AttemptId",
      "description": "Identifier of one attempt of a job.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "maxLength": 1024,
      "type": "string"
    },
    "size": {
      "minimum": 0,
      "type": "integer"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "received": {
      "minimum": 0,
      "type": "integer"
    },
    "created_at": {
      "title": "Timestamp",
      "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "updated_at": {
      "title": "Timestamp",
      "description": "RFC 3339 timestamp in UTC with a `Z` suffix and optional fractional seconds.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    }
  }
}
